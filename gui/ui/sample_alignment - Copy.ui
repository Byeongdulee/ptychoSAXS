     <!-- ================= page 2: roughly find sample center ================= -->
     <widget class="QWidget" name="page_rough_center">
      <layout class="QVBoxLayout" name="layout_rough_center">
       <item>
        <widget class="QLabel" name="lb_rough_title">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Now roughly find a sample position to align on:
- If the center of rotation is set, only use trans1/trans2!
- If the center of rotation is not set, set X to ~1.3 mm</string>
