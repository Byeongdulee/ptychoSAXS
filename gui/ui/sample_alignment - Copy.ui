     <!-- ====== page 6 (expert): find center + set rotation + check safe ====== -->
     <widget class="QWidget" name="page_position_and_rotation">
      <layout class="QVBoxLayout" name="layout_position_and_rotation">
       <item>
        <widget class="QLabel" name="lb_posrot_title">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Roughly find a sample position to align on, then verify rotating is safe.
- If the center of rotation is set, only use trans1/trans2, otherwise unlock and set X to ~1.3 mm
- Set the rotation angle to align with the trans1/trans2 axes, then check the safe range</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_posrot_body">
         <item>
          <widget class="QWidget" name="container_rows_posrot" native="true"/>
         </item>
         <item>
          <layout class="QGridLayout" name="layout_posrot_limits">
           <item row="0" column="0">
            <widget class="QPushButton" name="pb_x_set_low">
             <property name="toolTip">
              <string>Copy the current phi angle into the lower soft limit.</string>
             </property>
             <property name="text">
              <string>Set lower softlimit</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QLineEdit" name="ed_x_phi_low">
             <property name="text">
              <string>-270</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QPushButton" name="pb_x_set_high">
             <property name="toolTip">
              <string>Copy the current phi angle into the upper soft limit.</string>
             </property>
             <property name="text">
              <string>Set upper softlimit</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QLineEdit" name="ed_x_phi_high">
             <property name="text">
              <string>270</string>
             </property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QPushButton" name="pb_x_set_zero">
             <property name="toolTip">
              <string>Copy the current phi angle in as the zero reference used to judge the safe arc.</string>
             </property>
             <property name="text">
              <string>Set angle 0</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QLineEdit" name="ed_x_phi_zero">
             <property name="text">
              <string>0</string>
             </property>
            </widget>
           </item>
           <item row="3" column="0" colspan="2">
            <widget class="QLabel" name="lb_posrot_hint">
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="text">
              <string>Soft limits are not enforced on this page. They are enforced everywhere else.</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_posrot_picker">
         <item>
          <widget class="QLabel" name="lb_x_transh_prompt">
           <property name="text">
            <string>Horizontal motor is:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pb_posrot_trans1">
           <property name="toolTip">
            <string>Record trans1 as the horizontal stage (transH). Used by every later step.</string>
           </property>
           <property name="text">
            <string>trans1</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pb_posrot_trans2">
           <property name="toolTip">
            <string>Record trans2 as the horizontal stage (transH). Used by every later step.</string>
           </property>
           <property name="text">
            <string>trans2</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_posrot_picker">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_posrot_buttons">
         <item>
          <widget class="QPushButton" name="pb_x_rot_360_ok">
           <property name="text">
            <string>360 deg rotation OK
Continue</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pb_posrot_continue">
           <property name="text">
            <string>Continue</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_posrot_buttons">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="spacer_posrot_bottom">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ================= page 7: set first trans ================= -->
     <widget class="QWidget" name="page_first_trans">
      <layout class="QVBoxLayout" name="layout_first_trans">
       <item>
        <widget class="QLabel" name="lb_firsttrans_title">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Set horizontal trans stage to bring sample to the center of rotation.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QWidget" name="container_rows_firsttrans" native="true"/>
       </item>
       <item>
        <widget class="QLabel" name="lb_firsttrans_which">
         <property name="text">
          <string/>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_firsttrans_buttons">
         <item>
          <widget class="QPushButton" name="pb_first_continue">
           <property name="text">
            <string>Continue</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_firsttrans">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="spacer_firsttrans_bottom">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ================= page 8: set second trans ================= -->
     <widget class="QWidget" name="page_second_trans">
      <layout class="QVBoxLayout" name="layout_second_trans">
       <item>
        <widget class="QLabel" name="lb_secondtrans_title">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Set upstream/downstream trans stage to bring sample to the center of rotation.
Make a small angle step and adjust trans stage to bring back to center</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QWidget" name="container_rows_secondtrans" native="true"/>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_secondtrans_buttons">
         <item>
          <widget class="QPushButton" name="pb_second_finish">
           <property name="text">
            <string>Finished alignment</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_secondtrans">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="spacer_secondtrans_bottom">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ============ page 9 (expert): set both trans ============ -->
     <widget class="QWidget" name="page_trans_both">
      <layout class="QVBoxLayout" name="layout_trans_both">
       <item>
        <widget class="QLabel" name="lb_transboth_title">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Set the horizontal trans stage to bring the sample to the center of rotation, using the 180 deg phi step.
Then reduce the phi step and use the other trans stage: make a small angle step and adjust it to bring the sample back to center.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QWidget" name="container_rows_transboth" native="true"/>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_transboth_buttons">
         <item>
          <widget class="QPushButton" name="pb_both_finish">
           <property name="text">
            <string>Finished alignment</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_transboth">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="spacer_transboth_bottom">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ============ page 10: is the center of rotation known? ============ -->
     <widget class="QWidget" name="page_cor_known">
      <layout class="QVBoxLayout" name="layout_cor_known">
       <item>
        <widget class="QLabel" name="lb_cor_title">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Is the center of rotation identified on the X-ray eye?</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_cor_buttons">
         <item>
          <widget class="QPushButton" name="pb_cor_yes">
           <property name="text">
            <string>Yes, continue</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pb_cor_no">
           <property name="text">
            <string>No</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_cor">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="spacer_cor_bottom">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ============ page 11: set trans with small angles ============ -->
     <widget class="QWidget" name="page_small_angle_trans">
      <layout class="QVBoxLayout" name="layout_small_angle_trans">
       <item>
        <widget class="QLabel" name="lb_smallangle_title">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>First set horizontal trans to center of rotation.
Then rotate a small step with phi and bring the sample
back to the center with the upstream/downstream trans motor.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QWidget" name="container_rows_smallangle" native="true"/>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_smallangle_buttons">
         <item>
          <widget class="QPushButton" name="pb_small_finish">
           <property name="text">
            <string>Finished alignment</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_smallangle">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="spacer_smallangle_bottom">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ============ page 12: iterative alignment ============ -->
     <widget class="QWidget" name="page_iterative">
      <layout class="QHBoxLayout" name="layout_iterative">
       <item>
        <widget class="QLabel" name="lb_iter_script">
         <property name="minimumSize">
          <size>
           <width>420</width>
           <height>0</height>
          </size>
         </property>
         <property name="alignment">
          <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="textFormat">
          <enum>Qt::RichText</enum>
         </property>
         <property name="text">
          <string/>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QVBoxLayout" name="layout_iter_controls">
         <item>
          <widget class="QWidget" name="container_rows_iter" native="true"/>
         </item>
         <item>
          <layout class="QHBoxLayout" name="layout_iter_step_buttons">
           <item>
            <widget class="QPushButton" name="pb_iter_a">
             <property name="text">
              <string>Center found</string>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="spacer_iter_step">
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>40</width>
               <height>20</height>
              </size>
             </property>
            </spacer>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="layout_iter_nav_buttons">
           <item>
            <widget class="QPushButton" name="pb_iter_back">
             <property name="text">
              <string>Back one step</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="pb_iter_finish">
             <property name="text">
              <string>Finished!</string>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="spacer_iter_nav">
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>40</width>
               <height>20</height>
              </size>
             </property>
            </spacer>
           </item>
          </layout>
         </item>
         <item>
          <spacer name="spacer_iter_bottom">
           <property name="orientation">
            <enum>Qt::Vertical</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>20</width>
             <height>40</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
      </layout>
     </widget>

     <!-- ============ page 13: change sample ============ -->
     <widget class="QWidget" name="page_change_sample">
      <layout class="QVBoxLayout" name="layout_change_sample">
       <item>
        <widget class="QLabel" name="lb_change_title">
         <property name="alignment">
          <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>This sample cannot be rotated far enough to align it.

A full alignment needs a 180 deg rotation, and the safe range you set does not reach that far from the zero angle. Change the sample (or its mounting) so it clears the surrounding hardware through a wider angle, then start over.</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_change_buttons">
         <item>
          <widget class="QPushButton" name="pb_start_over">
           <property name="text">
            <string>Start over</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_change">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="spacer_change_bottom">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

    </widget>
   </item>

   <!-- ====== footer: present on every page, so it lives outside the stack ====== -->
   <item>
    <widget class="Line" name="line_footer">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="layout_footer">
     <item>
      <widget class="QPushButton" name="pb_unlock_all">
       <property name="toolTip">
        <string>Enable every motor this step has disabled, for this step only.</string>
       </property>
       <property name="text">
        <string>Unlock all</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="pb_back">
       <property name="text">
        <string>Return to previous page</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="spacer_footer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="pb_cancel">
       <property name="toolTip">
        <string>Abandon the alignment and close this window.</string>
       </property>
       <property name="text">
        <string>Cancel</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
