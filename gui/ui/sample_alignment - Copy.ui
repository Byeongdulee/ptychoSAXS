         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Set the rotation angle so the trans1/trans2 axes line up with the X-ray propagation direction.
One trans stage should then move the sample across the beam, and the other along it.
When the axes are lined up, press Done to go back to finding the sample center.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QWidget" name="container_rows_rotaxes" native="true"/>
