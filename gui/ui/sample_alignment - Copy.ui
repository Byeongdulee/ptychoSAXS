     <!-- ================= page 5: check rotation safe ================= -->
     <widget class="QWidget" name="page_rotation_safe">
      <layout class="QVBoxLayout" name="layout_rotation_safe">
       <item>
        <widget class="QLabel" name="lb_rotsafe_title">
         <property name="text">
          <string>Check safe rotation range</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QWidget" name="container_rows_rotsafe" native="true"/>
       </item>
       <item>
        <layout class="QGridLayout" name="layout_rotsafe_limits">
         <item row="0" column="0">
          <widget class="QPushButton" name="pb_set_low">
           <property name="toolTip">
            <string>Copy the current phi angle into the lower soft limit.</string>
           </property>
           <property name="text">
            <string>Set lower softlimit</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="ed_phi_low">
           <property name="text">
            <string>-270</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QPushButton" name="pb_set_high">
           <property name="toolTip">
            <string>Copy the current phi angle into the upper soft limit.</string>
           </property>
           <property name="text">
            <string>Set upper softlimit</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QLineEdit" name="ed_phi_high">
           <property name="text">
            <string>270</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QPushButton" name="pb_set_zero">
           <property name="toolTip">
            <string>Copy the current phi angle in as the zero reference used to judge the safe arc.</string>
           </property>
           <property name="text">
            <string>Set angle 0</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QLineEdit" name="ed_phi_zero">
           <property name="text">
            <string>0</string>
           </property>
          </widget>
         </item>
         <item row="0" column="2" rowspan="3">
          <spacer name="spacer_rotsafe_limits">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="lb_rotsafe_hint">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Soft limits are not enforced on this page, so you can rotate past them to find them. They are enforced everywhere else.</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layout_rotsafe_buttons">
         <item>
          <widget class="QPushButton" name="pb_rot_360_ok">
           <property name="text">
            <string>360 deg rotation OK
Continue</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pb_rotsafe_continue">
           <property name="text">
            <string>Continue</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_rotsafe_buttons">
           <property name="orientation">
