     <!-- ================= page 0: check radiography mode ================= -->
     <widget class="QWidget" name="page_radiography">
      <layout class="QHBoxLayout" name="layout_radiography">
       <item>
        <widget class="QLabel" name="lb_radio_instructions">
         <property name="minimumSize">
          <size>
           <width>340</width>
           <height>0</height>
          </size>
         </property>
         <property name="alignment">
          <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Change to radiography mode:
- Put X-ray eye in
- Verify X-rays are on camera
- If energy &gt; 12 keV, insert
SAXS beamstop
- Remove ZP optics</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QVBoxLayout" name="layout_radio_controls">
         <item>
          <layout class="QHBoxLayout" name="layout_eye_buttons">
